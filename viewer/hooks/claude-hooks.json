{
  "description": "kanban 本地服务与会话约定（Claude Code）",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/codex-hook.mjs", "start"],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/codex-hook.mjs", "activity"],
            "timeout": 12,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/server/codex-hook.mjs", "activity"],
            "timeout": 12,
            "async": true
          }
        ]
      }
    ]
  }
}
